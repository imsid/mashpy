# Mash's sandbox image: the computer each user's agents run code on.
#
# Published as ghcr.io/imsid/mash-sandbox:<mashpy version>; hosts use it unless
# MASH_SANDBOX_IMAGE names another. Build on it to add packages:
#
#   FROM ghcr.io/imsid/mash-sandbox:<version>
#   RUN pip install <package>
#
# What run_code's description promises lives here: change both together
# (src/mash/tools/sandbox.py).

FROM node:22-slim AS node

FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1
ENV PIP_NO_CACHE_DIR=1

RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates curl git jq ripgrep sqlite3 \
    && rm -rf /var/lib/apt/lists/*

COPY --from=node /usr/local/bin/node /usr/local/bin/node
COPY --from=node /usr/local/lib/node_modules /usr/local/lib/node_modules
RUN ln -s ../lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm \
    && ln -s ../lib/node_modules/npm/bin/npx-cli.js /usr/local/bin/npx \
    && node --version && npm --version

# Data libraries are not preinstalled: the model installs what it needs with
# `pip install --user`, into the agent's folder on the user's volume.
RUN pip install uv

WORKDIR /opt/mash
COPY pyproject.toml uv.lock README.md ./
COPY src ./src
RUN pip install .

# The daemon runs as root and holds the sandbox token. It runs each agent's
# code as a uid of the agent's own, in a folder only that uid may use
# (src/mash/sandbox/agent_users.py), so agents can read neither each other's
# files nor their processes' environment. Each user's volume is created from
# /home/agent/workspaces; no agent may create folders at its top.
RUN mkdir -p /home/agent/workspaces \
    && chmod 0711 /home/agent /home/agent/workspaces \
    # Mounted checkouts belong to other uids; let git read them anyway.
    && git config --system --add safe.directory '*'

WORKDIR /

EXPOSE 9000

CMD ["mash", "sandbox", "serve"]
